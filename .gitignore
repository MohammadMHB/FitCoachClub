# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/

# Secrets / environment
.env
.env.*
!.env.example

# Database (contains real user data - never commit)
*.sqlite3
*.sqlite3-journal
*.db

# Generated by collectstatic
/staticfiles/*
!/staticfiles/.gitkeep

# User uploads
/media/exercises/images/*
!/media/exercises/images/.gitkeep
/media/exercises/videos/*
!/media/exercises/videos/.gitkeep
/media/profiles/*
!/media/profiles/.gitkeep
/media/gifs/*
!/media/gifs/.gitkeep

# Logs
/logs/*.log

# Old archives / backups
*.zip
*.bak
__MACOSX/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

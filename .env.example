# Copy to .env and fill in real values. NEVER commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.ir,www.example.ir,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ir,https://www.example.ir

# Melipayamak SMS (leave empty to disable SMS)
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_SENDER=

# Feature flags
NUTRITION_ENABLED=False

# SMS login (password login remains available)
OTP_LOGIN_ENABLED=True
# Approved service pattern with exactly one parameter: the six-digit code.
# Leave empty to send a plain SMS from MELIPAYAMAK_SENDER instead.
MELIPAYAMAK_OTP_BODY_ID=
# Enable only when the hosting proxy overwrites client-supplied X-Forwarded-For.
OTP_TRUST_X_FORWARDED_FOR=False
